# ctrip-mcp 不需要 token! 抓的是公开 m 端 h5 SPA 接口.
# 所有配置项都有合理默认值, 复制此文件为 .env 然后按需修改.

# 抓取产物落盘路径 (默认 /opt/data/ctrip-data/)
# CTRIP_DATA_DIR=/opt/data/ctrip-data/

# chromium 路径 (默认自动探测 ~/.cache/ms-playwright/chromium-*/chrome)
# CTRIP_CHROMIUM=/opt/google/chrome/chrome

# 抓取超时秒 (默认 60)
# CTRIP_TIMEOUT=60

# MCP 协议日志级别 (默认 INFO)
# MCP_LOG_LEVEL=INFO
